# Copy this file to .env and fill in your key.
# .env is gitignored and never committed.

# Google Fonts Developer API key.
# Obtain one at https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable the "Web Fonts Developer API" for your project (free quota is sufficient).
# Required only for: npm run google-fonts
GOOGLE_FONTS_API_KEY=

# Hugging Face read token (optional but recommended).
# Create one at https://huggingface.co/settings/tokens ("Read" scope is enough).
# The Hub rate-limits anonymous traffic by IP and this source makes one request
# per model, so an unauthenticated run is slow and may drop models to 429s.
# Used by: npm run huggingface
HF_TOKEN=
